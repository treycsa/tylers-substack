# Copy to .env and fill in. Never commit .env. Keep comments on their own line: python-dotenv reads
# `KEY=   # note` as the value "# note", which makes an unfilled key look set.

# classic or fine-grained token, public_repo read is enough (5,000 req/hr)
GITHUB_TOKEN=
# optional; without it the scorer uses heuristics and the drafts are template-only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# `substack publish --api` (cookie auth, python-substack). Set ONE of these. The cookie grants full account
# access: never commit it, never paste it in chat. Quote the value, it contains spaces and semicolons,
# e.g. SUBSTACK_COOKIES="connect.sid=s%3A...; substack.sid=..." — the Cookie header from devtools (Network
# tab) on substack.com.
SUBSTACK_COOKIES=
# or a JSON file of {"name": "value"} cookies (python-substack's export_cookies() format). Keep it OUTSIDE
# the repo, e.g. ~/.config/tylers-substack/cookies.json (cookies*.json is git-ignored as a backstop).
SUBSTACK_COOKIES_PATH=

# optional/legacy: only read by `scan --source posts|both` (one JSON object per line)
POSTS_PATH=data/posts.jsonl
# optional: Chrome remote-debugging URL for `substack linkedin-scan` (default http://127.0.0.1:9222)
LINKEDIN_CDP_URL=
DB_PATH=data/pipeline.sqlite
OUT_DIR=out
TESTED_DIR=tested-daily
