# Copy to .env and fill in. Never commit .env.
GITHUB_TOKEN=            # classic or fine-grained token, public_repo read is enough (5,000 req/hr)
ANTHROPIC_API_KEY=       # optional; without it the scorer uses heuristics and the drafts are template-only
ANTHROPIC_MODEL=claude-sonnet-4-5
POSTS_PATH=data/posts.jsonl          # your LinkedIn scraper's output (one JSON object per line)
DB_PATH=data/pipeline.sqlite
OUT_DIR=out
TESTED_DIR=tested-daily
